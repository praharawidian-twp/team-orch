def find_workspace_root() -> Path:
    cwd = Path.cwd().resolve()
    for p in [cwd] + list(cwd.parents):
        if p == Path.home() or p in Path.home().parents or str(p) == "/":
            break
        if (p / ".agents").exists() or (p / ".git").exists():
            return p
    script_dir = Path(__file__).resolve().parent
    for p in [script_dir, script_dir.parent]:
        if p == Path.home() or p in Path.home().parents or str(p) == "/":
            continue
        if (p / ".agents").exists() or (p / ".git").exists():
            return p
    return cwd

def resolve_cmd(cmd_name: str) -> str:
    ws = find_workspace_root()
    local_cmd = ws / "cmd" / cmd_name
    if local_cmd.is_file() and os.access(local_cmd, os.X_OK):
        return str(local_cmd)
    found = shutil.which(cmd_name)
    if found:
        return found
    return cmd_name


