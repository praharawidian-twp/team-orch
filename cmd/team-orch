def get_role_data(role_id: str) -> Dict[str, Any]:
    r_id = role_id.lower()
    r_id_normalized = {
        "pm": "project-manager",
        "analis": "analyst",
        "dev": "coder",
        "doc": "documenter",
        "qa": "qa-engineer",
        "ops": "devops",
        "infra": "devops"
    }.get(r_id, r_id)

    roles_dir = get_roles_dir()
    yaml_file = roles_dir / f"{r_id_normalized}.yaml"
    if yaml_file.exists():
        data = load_yaml(yaml_file)
        if "id" not in data:
            data["id"] = r_id_normalized
        return data

    # Markdown fallback
    md_file = roles_dir / f"{r_id_normalized}.md"
    if md_file.exists():
        content = md_file.read_text(encoding="utf-8")
        title_m = re.search(r"^#\s*Role:\s*(.+)$", content, re.MULTILINE)
        title = title_m.group(1).strip() if title_m else r_id_normalized.capitalize()
        return {
            "id": r_id_normalized,
            "title": title,
            "model_tier": ROLE_MODELS.get(r_id_normalized, "medium"),
            "description": f"Role {r_id_normalized} from markdown file",
            "system_prompt": content
        }

    return {
        "id": r_id_normalized,
        "title": r_id_normalized.capitalize(),
        "model_tier": ROLE_MODELS.get(r_id_normalized, "medium"),
        "description": "Dynamic role",
        "system_prompt": f"Anda bertindak sebagai {r_id_normalized}."
    }

def list_all_roles() -> List[Dict[str, Any]]:
    roles_dir = get_roles_dir()
    results = []
    seen = set()

    for yf in sorted(roles_dir.glob("*.yaml")):
        data = load_yaml(yf)
        rid = data.get("id", yf.stem)
        seen.add(rid)
        results.append(data)

    for mf in sorted(roles_dir.glob("*.md")):
        rid = mf.stem
        if rid not in seen:
            data = get_role_data(rid)
            seen.add(rid)
            results.append(data)
    return results

