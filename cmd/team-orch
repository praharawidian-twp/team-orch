DEFAULT_EVENT_SEVERITIES = {
    # SILENT: zero token, logged to disk only, PM stays completely asleep
    "TASK_PROGRESS": "SILENT",
    "CODE_EDIT": "SILENT",
    "UNIT_TEST_PASS": "SILENT",
    "PEER_QUERY": "SILENT",
    "PEER_REPLY": "SILENT",
    "DOCS_UPDATE": "SILENT",
    "AUDIT_RECORD": "SILENT",
    "HANDOFF_REVIEW": "SILENT",

    # TELEMETRY: zero token, updates terminal UI / status bar only
    "STAGE_PROGRESS": "TELEMETRY",
    "PANE_STATUS_CHANGE": "TELEMETRY",
    "HEARTBEAT": "TELEMETRY",

    # ACTIONABLE: High-value / blocker, alerts Control Room & wakes PM
    "GATE_APPROVAL_NEEDED": "ACTIONABLE",
    "CIRCUIT_BREAKER_TRIPPED": "ACTIONABLE",
    "ESCALATION": "ACTIONABLE",
    "PROJECT_COMPLETED": "ACTIONABLE",
    "FATAL_ERROR": "ACTIONABLE",
}

def determine_severity(event_type: str, explicit_severity: Optional[str] = None) -> str:
    if explicit_severity and explicit_severity.upper() in ("SILENT", "TELEMETRY", "ACTIONABLE"):
        return explicit_severity.upper()
    return DEFAULT_EVENT_SEVERITIES.get(event_type.upper(), "SILENT")

def record_bus_event(project_id: Optional[str], from_role: str, to_role: str, event_type: str, message: str = "", payload: Optional[dict] = None, severity: Optional[str] = None) -> str:
    ensure_dirs()
    sev = determine_severity(event_type, severity)
    event_data = format_bus_event(
        project_id=project_id,
        from_role=from_role,
        to_role=to_role,
        event_type=event_type,
        message=message or f"Event {event_type} from {from_role} to {to_role}",
        payload=payload,
        severity=sev,
        status="PROCESSED"
    )
    try:
        safe_append(BUS_EVENTS_FILE, json.dumps(event_data))
        compact_message_bus(BUS_EVENTS_FILE, max_size_bytes=5 * 1024 * 1024, force=False)
    except Exception:
        pass
    return event_data["event_id"]

def check_circuit_breaker(project_id: Optional[str], from_role: str, to_role: str, event_type: str) -> Tuple[bool, Optional[str]]:
    if not project_id:
        return True, None
    p_dir = get_project_dir(project_id)
    if not p_dir.exists():
        return True, None

    manifest = get_or_create_manifest(project_id)
    guardrails = manifest.setdefault("guardrails", {
        "circuit_breaker_status": "ACTIVE",
        "current_retries": 0,
        "turn_count": 0,
        "max_peer_turns": 2,
        "max_rejection_retries": 3,
        "locked_at": None,
        "lock_reason": None
    })

    if guardrails.get("circuit_breaker_status") == "LOCKED":
        return False, f"CIRCUIT BREAKER IS LOCKED! Agen '{from_role}' dibungkam otomatis untuk mencegah pemborosan token. Alasan: {guardrails.get('lock_reason')}. Buka kunci dengan: team-orch resolve {project_id}"

    # Check peer turns
    if event_type.upper() in ("PEER_QUERY", "CLARIFICATION", "DEBATE"):
        guardrails["turn_count"] = guardrails.get("turn_count", 0) + 1
        max_turns = guardrails.get("max_peer_turns", 2)
        if guardrails["turn_count"] > max_turns:
            guardrails["circuit_breaker_status"] = "LOCKED"
            guardrails["locked_at"] = datetime.now().isoformat()
            guardrails["lock_reason"] = f"Batas komunikasi dialog peer ({max_turns} putaran) terlampaui antara {from_role} dan {to_role}."
            save_manifest(project_id, manifest)
            append_audit_log(
                project_id=project_id,
                role="system",
                event="CIRCUIT_BREAKER_TRIPPED",
                desc=guardrails["lock_reason"],
                status="THROTTLED",
                security="CIRCUIT BREAKER ACTIVATED - ZERO TOKEN GUARD ENFORCED",
                next_step=f"Human intervention required: team-orch resolve {project_id} --note '<resolution>'"
            )
            return False, f"CIRCUIT BREAKER TRIPPED! Batas dialog ({max_turns} putaran) tercapai. Agen dibungkam otomatis demi mencegah token burn. Silakan buka kunci via Control Room."

    # Check rejection retries
    if event_type.upper() in ("REJECT_REVIEW", "REVIEW_REJECTED", "REVISION_REQUESTED"):
        guardrails["current_retries"] = guardrails.get("current_retries", 0) + 1
        max_retries = guardrails.get("max_rejection_retries", 3)
        manifest["gate_status"]["review_iteration"] = guardrails["current_retries"]
        if guardrails["current_retries"] >= max_retries:
            guardrails["circuit_breaker_status"] = "LOCKED"
            guardrails["locked_at"] = datetime.now().isoformat()
            guardrails["lock_reason"] = f"Batas maksimal iterasi revisi kode ({max_retries}x) terlampaui."
            save_manifest(project_id, manifest)
            append_audit_log(
                project_id=project_id,
                role="system",
                event="CIRCUIT_BREAKER_TRIPPED",
                desc=guardrails["lock_reason"],
                status="THROTTLED",
                security="CIRCUIT BREAKER ACTIVATED - ZERO TOKEN GUARD ENFORCED",
                next_step=f"Human intervention required: team-orch resolve {project_id} --note '<resolution>'"
            )
            return False, f"CIRCUIT BREAKER TRIPPED! Revisi sudah ditolak {max_retries} kali. Agen dibungkam otomatis untuk mencegah perdebatan tanpa akhir. Hubungi Control Room."

    save_manifest(project_id, manifest)
    return True, None

