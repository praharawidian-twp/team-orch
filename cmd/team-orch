        f"- Waktu Penyerahan: `{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}`\n"
        f"- Berkas Masukan (Input Artifacts): {', '.join(f'`{f}`' for f in stage.get('input_artifacts', [])) if stage.get('input_artifacts') else 'None'}\n"
