            print(f"[!] Peringatan: Proyek diarsipkan sebelum seluruh tahapan workflow selesai ({stage_idx}/{len(stages)} selesai).")

    # 3. Mark Completed & Record Audit
    manifest["status"] = "COMPLETED"
    manifest["completed_at"] = datetime.now().isoformat()
