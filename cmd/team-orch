def build_stage_prompt(role: str, project_id: str, stage: Optional[Dict[str, Any]] = None) -> str:
    p_dir = get_project_dir(project_id)
    r_data = get_role_data(role)

    # Resolve system prompt
    system_prompt = r_data.get("system_prompt", "")
    if not system_prompt and "system_prompt_file" in r_data:
        sp_file = get_roles_dir() / r_data["system_prompt_file"]
        if sp_file.exists():
            system_prompt = sp_file.read_text(encoding="utf-8")

    parts = [
        f"# INSTRUCTION: ACT AS ROLE [{role.upper()} - {r_data.get('title', role)}]\n",
        system_prompt,
        f"\n\n--- PROJECT CONTEXT: {project_id} ---",
        f"Workspace Path: {p_dir}",
    ]

    manifest = get_or_create_manifest(project_id)
    eff_domain_id, d_manifest, domain_err = resolve_project_domain(manifest)
    if domain_err:
        raise RuntimeError(domain_err)

    target_dir = manifest.get("target_dir")
    if target_dir:
        parts.append(f"Target Source Code Directory: {target_dir} (Semua berkas implementasi kode dan unit tests WAJIB dibuat di dalam direktori ini!)")

    parts.append(format_domain_context_block(eff_domain_id, d_manifest))


    if stage:
        parts.append(f"Current Stage: {stage.get('name', stage.get('id'))}")
        inp_arts = stage.get("input_artifacts", [])
        out_arts = stage.get("output_artifacts", [])
        if inp_arts:
            parts.append(f"Input Artifacts: {', '.join(inp_arts)}")
        if out_arts:
            parts.append(f"Expected Output Artifacts: {', '.join(out_arts)}")

    # Inject Input Artifacts
    req_f = p_dir / "01-requirements.md"
    spec_f = p_dir / "02-technical-spec.md"
    task_f = p_dir / "03-task-list.md"
    rev_f = p_dir / "review-log.md"

    if req_f.exists():
        parts.append(f"\n### [01-requirements.md]:\n{req_f.read_text(encoding='utf-8')}")
    if spec_f.exists():
        parts.append(f"\n### [02-technical-spec.md]:\n{spec_f.read_text(encoding='utf-8')}")
    if task_f.exists():
        parts.append(f"\n### [03-task-list.md]:\n{task_f.read_text(encoding='utf-8')}")
    if rev_f.exists():
        parts.append(f"\n### [review-log.md]:\n{rev_f.read_text(encoding='utf-8')}")

    # Audit Trail context (last 4 entries)
    audit_f = p_dir / "audit-trail.md"
    if audit_f.exists():
        text = audit_f.read_text(encoding="utf-8")
        entries = re.findall(r"(###\s*\[AUDIT-\d+\].*?)(?=\n###\s*\[AUDIT|\Z)", text, re.DOTALL)
        if entries:
            last_entries = "\n".join(entries[-4:])
            parts.append(f"\n### [audit-trail.md - Catatan Aktivitas Terakhir]:\n{last_entries}")

    # Inject Permitted Knowledge Catalog Index (Zero-Bloat Progressive Disclosure)
    kb_items = get_accessible_knowledge(role, domain_id=eff_domain_id)
    if kb_items:
        kb_lines = [
            "\n### [KNOWLEDGE BASE CATALOG (Tersedia Sesuai Peran Anda)]:",
            "Anda memiliki akses on-demand ke topik panduan & aturan berikut.",
            "Untuk membaca materi lengkap saat dibutuhkan, jalankan: team-orch knowledge read <topic_id>\n"
        ]
        for item in kb_items:
            src_tag = "[BASE]" if item.get("_source") == BASE_DOMAIN_ID else f"[{str(item.get('_source')).upper()}]"
            kb_lines.append(f"- `{src_tag}` `[kb:{item.get('id')}]` {item.get('title')} ({item.get('category')}) - {item.get('summary', '')}")
        parts.append("\n".join(kb_lines))

    # Layer 1: Non-Negotiable Framework Kernel Directives
    parts.append(
        "\n### [MANDATORY FRAMEWORK KERNEL DIRECTIVES - NON-NEGOTIABLE]:\n"
        "1. IMMUTABILITY: Direktori `cmd/`, `installer/`, dan konfigurasi engine `.agents/` berstatus READ-ONLY. DILARANG KERAS memodifikasinya.\n"
        "2. WORKSPACE CONFINEMENT: Pekerjaan implementasi kode HANYA boleh dibuat di `target_dir`. DILARANG membuat skrip liar di root.\n"
        "3. SCRATCHPAD & REUSABILITY: Jika butuh skrip debug/dummy data/eksperimen mandiri, simpan di `.agents/tasks/active/<project_id>/scratch/`.\n"
        "   Periksa scratchpad sebelum membuat skrip baru untuk menggunakan kembali (reuse) skrip yang sudah ada dan menghemat token.\n"
        "4. KNOWLEDGE COMPLIANCE: Patuhi aturan yang bertanda STRICT di Knowledge Base. Melanggar aturan akan di-REJECT oleh Gatekeeper.\n"
        "5. GIT READ-ONLY POLICY: DILARANG menjalankan perintah mutasi git (git add, git commit, git push). Hanya gunakan git status/diff/log.\n"
        "6. AUDIT LOGGING: Catat setiap aksi teknis dan verifikasi keamanan ke audit trail sebelum handoff."
    )

    return "\n".join(parts)

