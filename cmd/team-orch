def compact_jsonl_file(path: Path, max_lines: int = 100, retain_lines: int = 50):
    """Keep JSONL files compact with atomic zero-data-loss compaction."""
    if not path.exists():
        return
    try:
        res = compact_message_bus(path, max_size_bytes=5 * 1024 * 1024, force=False)
        if res.get("status") == "compacted":
            return
        lines = path.read_text(encoding="utf-8").splitlines()
        if len(lines) > max_lines:
            retained = lines[-retain_lines:]
            safe_atomic_write(path, "\n".join(retained) + "\n")
    except Exception:
        pass

