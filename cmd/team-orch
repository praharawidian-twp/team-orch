def get_or_create_manifest(project_id: str, workflow_id: str = DEFAULT_WORKFLOW_ID) -> Dict[str, Any]:
    p_dir = get_project_dir(project_id)
    manifest_file = p_dir / "project.yaml"
    if manifest_file.exists():
        data = load_yaml(manifest_file)
        if data and "workflow" in data:
            data.setdefault("execution_mode", "fleet")
            data.setdefault("guardrails", {
                "circuit_breaker_status": "ACTIVE",
                "current_retries": 0,
                "turn_count": 0,
                "max_peer_turns": 2,
                "max_rejection_retries": 3,
                "locked_at": None,
                "lock_reason": None
            })
            return data

    # Create new manifest from workflow
    wf = load_workflow(workflow_id)
    stages = wf.get("stages", [])
    first_stage_id = stages[0]["id"] if stages else "start"

    # Infer approval status and progress from existing project files
    req_file = p_dir / "01-requirements.md"
    spec_file = p_dir / "02-technical-spec.md"
    rev_file = p_dir / "review-log.md"

    req_approved = False
    if req_file.exists():
        text = req_file.read_text(encoding="utf-8")
        m = re.search(r"Status(?:\s*Persetujuan)?\s*:\s*[`\[]?\s*APPROVED\b", text, re.IGNORECASE)
        if m and "|" not in text.split("Status")[1].splitlines()[0]:
            req_approved = True


    current_idx = 0
    code_reviewed = False
    review_verdict = None

    if rev_file.exists():
        rev_text = rev_file.read_text(encoding="utf-8")
        if "PASSED" in rev_text.upper() or "APPROVED" in rev_text.upper():
            code_reviewed = True
            review_verdict = "APPROVED"
            current_idx = 4  # Stage 5: documentation
        elif ("REVIEW REQUEST" in rev_text.upper() or "PENGAJUAN REVIEW" in rev_text.upper() or "TASK-" in rev_text.upper()) and "MENUNGGU CODER" not in rev_text.upper():
            current_idx = 3  # Stage 4: review
        elif spec_file.exists():
            current_idx = 2  # Stage 3: implementation
    elif spec_file.exists():
        current_idx = 2  # Stage 3: implementation
    elif req_approved:
        current_idx = 1  # Stage 2: architecture

    current_stage_id = stages[current_idx]["id"] if current_idx < len(stages) else "complete"

    data = {
        "project_id": project_id,
        "created_at": datetime.now().isoformat(),
        "workflow": wf.get("workflow_id", workflow_id),
        "status": "ACTIVE",
        "execution_mode": "fleet",
        "current_stage_id": current_stage_id,
        "current_stage_index": current_idx,
        "total_stages": len(stages),
        "gate_status": {
            "user_approved": req_approved,
            "approved_at": datetime.now().isoformat() if req_approved else None,
            "code_reviewed": code_reviewed,
            "review_verdict": review_verdict,
            "review_iteration": 0
        },
        "guardrails": {
            "circuit_breaker_status": "ACTIVE",
            "current_retries": 0,
            "turn_count": 0,
            "max_peer_turns": 2,
            "max_rejection_retries": 3,
            "locked_at": None,
            "lock_reason": None
        },
        "assigned_panes": {
            "control_room": os.environ.get("HERDR_PANE_ID", "w8:p1"),
            "project_manager": os.environ.get("HERDR_PANE_ID", "w8:p1")
        },
        "stage_history": []
    }

    if p_dir.exists():
        manifest_file.write_text(dump_yaml(data), encoding="utf-8")
    return data

def save_manifest(project_id: str, manifest: Dict[str, Any]):
    p_dir = get_project_dir(project_id)
    manifest_file = p_dir / "project.yaml"
    manifest_file.write_text(dump_yaml(manifest), encoding="utf-8")

