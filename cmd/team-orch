    # File-Driven Task Handoff: Write full prompt to disk
    handoff_file = p_dir / "task-handoff.md"
    handoff_content = (
        f"# TASK HANDOFF: {stage.get('name').upper()}\n"
        f"- Proyek: `{project_id}`\n"
