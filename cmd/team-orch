def cmd_init(args):
    ensure_dirs()
    project_id = args.project_id
    workflow_id = args.workflow or DEFAULT_WORKFLOW_ID
    p_dir = ACTIVE_TASKS_DIR / project_id

    if p_dir.exists():
        print(f"[!] Project '{project_id}' already exists at: {p_dir}")
        return

    p_dir.mkdir(parents=True, exist_ok=True)
    templates_dir = get_templates_dir()

    # Copy requirements template
    req_template = templates_dir / "requirements-template.md"
    req_file = p_dir / "01-requirements.md"
    if req_template.exists():
        content = req_template.read_text(encoding="utf-8")
        content = content.replace("[PROJECT_NAME_OR_ID]", project_id)
        req_file.write_text(content, encoding="utf-8")

    # Provision dedicated task scratchpad
    scratch_dir = p_dir / "scratch"
    scratch_dir.mkdir(parents=True, exist_ok=True)
    (scratch_dir / ".gitkeep").write_text("", encoding="utf-8")

    # Initialize manifest
    target_dir = getattr(args, "target_dir", None)
    req_domain = getattr(args, "domain", None)
    eff_domain = _sanitize_domain_id(req_domain) if req_domain else get_active_domain_id()
    if eff_domain in ("", "none"):
        eff_domain = BASE_DOMAIN_ID
    if eff_domain != BASE_DOMAIN_ID and not find_domain_dir(eff_domain):
        print(f"🛑 [ERROR] Domain '{eff_domain}' tidak ditemukan. Jalankan 'team-orch domain list' atau gunakan '--domain base'.")
        shutil.rmtree(p_dir, ignore_errors=True)
        sys.exit(1)

    manifest = get_or_create_manifest(project_id, workflow_id)
    if target_dir:
        manifest["target_dir"] = target_dir
    manifest["domain_id"] = eff_domain

    exec_mode = "silent" if (getattr(args, "silent", False) or getattr(args, "mode", None) == "silent") else "fleet"
    manifest["execution_mode"] = exec_mode
    save_manifest(project_id, manifest)

    # Initial audit log
    append_audit_log(
        project_id=project_id,
        role="pm",
        event="PROJECT_INIT",
        desc=f"Inisialisasi proyek baru dengan workflow '{workflow_id}' [{exec_mode.upper()} MODE] [domain:{eff_domain}]",
        files=["01-requirements.md", "project.yaml"],
        next_step="PM mengumpulkan kebutuhan dan menyusun dokumen 01-requirements.md"
    )

    print(f"[✓] Successfully initialized project '{project_id}' with workflow '{workflow_id}'!")
    print(f"    Location : {p_dir}")
    print(f"    Manifest : {p_dir}/project.yaml")
    print(f"    Domain   : {eff_domain}")
    if exec_mode == "silent":
        print(f"    Mode     : 🔕 SILENT (Single Worker Pane / Background Runner)")
        print(f"               Semua agen & tahapan dieksekusi terpadu di 1 worker pane tanpa memecah multi-pane.")
    else:
        print(f"    Mode     : 🌐 FLEET (Autonomous Multi-Pane: 1 Role = 1 Dedicated Pane)")
    print(f"\n👉 Langkah selanjutnya:")
    print(f"   1. Susun kebutuhan di '{project_id}/01-requirements.md'.")
    print(f"   2. Ketik 'team-orch approve {project_id}' untuk menyetujui lingkup kerja.")
    print(f"   3. Ketik 'team-orch next {project_id}' untuk menjalankan tahap berikutnya secara otomatis.")

def cmd_approve(args):
    project_id = args.project_id
    p_dir = get_project_dir(project_id)
    if not p_dir.exists():
        print(f"[!] Project '{project_id}' not found.")
        return

    req_file = p_dir / "01-requirements.md"
    if req_file.exists():
        text = req_file.read_text(encoding="utf-8")
        has_discovery = bool(re.search(r"(Discovery Log|Tanya-Jawab Kebutuhan|Wawancara Kebutuhan|Requirement Discovery)", text, re.IGNORECASE))
        has_boilerplate = bool(re.search(r"(Boilerplate Reference|Basis Boilerplate|Referensi Boilerplate)", text, re.IGNORECASE))
        if not (has_discovery and has_boilerplate):
            print("=" * 80)
            print("🛑 [BLOCKED BY ANTI-ASSUMPTION GATE]: Approval Ditolak!")
            print(f" Dokumen '{req_file}' terdeteksi tidak memiliki:")
            if not has_discovery:
                print("   • Bukti 'Discovery Log / Tanya-Jawab Kebutuhan' (Wajib sesi wawancara langsung)")
            if not has_boilerplate:
                print("   • 'Referensi Boilerplate' (Wajib merujuk basis boilerplate resmi)")
            print("\n⚠️ AI DILARANG mengasumsikan requirement sepihak dari imajinasi!")
            print("   Lakukan sesi wawancara klarifikasi dengan Pengguna di Control Room terlebih dahulu,")
            print("   lalu sertakan transkrip kesepakatan tersebut ke dalam '01-requirements.md'.")
            print("=" * 80)
            sys.exit(1)

        if "PENDING_APPROVAL" in text:
            text = text.replace("PENDING_APPROVAL", f"APPROVED by {args.approver} on {datetime.now().strftime('%Y-%m-%d %H:%M')}")
        elif "Status: DRAFT" in text:
            text = text.replace("Status: DRAFT", f"Status: APPROVED by {args.approver} on {datetime.now().strftime('%Y-%m-%d %H:%M')}")
        req_file.write_text(text, encoding="utf-8")

    gdd_file = p_dir / "01-gdd.md"
    if gdd_file.exists():
        text = gdd_file.read_text(encoding="utf-8")
        if "PENDING_APPROVAL" in text:
            text = text.replace("PENDING_APPROVAL", f"APPROVED by {args.approver} on {datetime.now().strftime('%Y-%m-%d %H:%M')}")
        elif "Status: DRAFT" in text:
            text = text.replace("Status: DRAFT", f"Status: APPROVED by {args.approver} on {datetime.now().strftime('%Y-%m-%d %H:%M')}")
        gdd_file.write_text(text, encoding="utf-8")

    manifest = get_or_create_manifest(project_id)
    manifest["gate_status"]["user_approved"] = True
    manifest["gate_status"]["approved_at"] = datetime.now().isoformat()
    wf = load_workflow(manifest.get("workflow", DEFAULT_WORKFLOW_ID))
    stages = wf.get("stages", [])
    if stages and manifest.get("current_stage_index", 0) == 0:
        manifest["current_stage_index"] = 1
        if len(stages) > 1:
            manifest["current_stage_id"] = stages[1]["id"]
    save_manifest(project_id, manifest)


    logged_files = ["project.yaml"]
    if req_file.exists():
        logged_files.append("01-requirements.md")
    if gdd_file.exists():
        logged_files.append("01-gdd.md")

    append_audit_log(
        project_id=project_id,
        role="user",
        event="REQUIREMENTS_APPROVED",
        desc=f"Persetujuan User Approval Gate diberikan oleh {args.approver}",
        files=logged_files,
        next_step="Lanjut ke tahap arsitektur teknis oleh Analis/Tech Lead"
    )

    print(f"[✓] User Approval Gate berhasil disetujui untuk proyek '{project_id}'!")
    if getattr(args, "auto", False):
        print(f"👉 Meluncurkan Auto-Pilot Pipeline Runner secara otonom...")
        cmd_auto(args)
    else:
        print(f"👉 Jalankan auto-dispatch tahap berikutnya dengan:")
        print(f"   ./cmd/team-orch next {project_id}")
        print(f"   (atau jalankan transisi otonom penuh via: ./cmd/team-orch auto {project_id})")

def cmd_next(args):
    project_id = args.project_id
    p_dir = get_project_dir(project_id)
    if not p_dir.exists():
        print(f"[!] Active project '{project_id}' not found.")
        return

    manifest = get_or_create_manifest(project_id)
    eff_domain_id, _, domain_err = resolve_project_domain(manifest)
    if domain_err:
        print(f"\n{domain_err}\n")
        sys.exit(2)

    if getattr(args, "mode", None):
        manifest["execution_mode"] = args.mode
        save_manifest(project_id, manifest)
    elif getattr(args, "silent", False):
        manifest["execution_mode"] = "silent"
        save_manifest(project_id, manifest)

    wf_id = manifest.get("workflow", DEFAULT_WORKFLOW_ID)
    wf = load_workflow(wf_id)
    stages = wf.get("stages", [])

    # Support stage override or rollback (e.g. --stage build or --stage 1)
    if getattr(args, "stage", None) is not None:
        target_val = str(args.stage).strip().lower()
        target_idx = None
        for i, s in enumerate(stages):
            if str(i) == target_val or str(i + 1) == target_val or s.get("id", "").lower() == target_val:
                target_idx = i
                break
        if target_idx is not None:
            manifest["current_stage_index"] = target_idx
            manifest["current_stage_id"] = stages[target_idx]["id"]
            manifest["status"] = "ACTIVE"
            st_id = stages[target_idx]["id"]
            if "stage_status" in manifest and st_id in manifest["stage_status"]:
                manifest["stage_status"][st_id] = "PENDING"
            save_manifest(project_id, manifest)
            print(f"[*] [STAGE OVERRIDE] Beralih ke tahap {target_idx + 1}/{len(stages)}: '{stages[target_idx].get('name')}' ({stages[target_idx].get('role', '').upper()})")
        else:
            print(f"[!] Target stage '{args.stage}' tidak ditemukan dalam alur kerja '{wf_id}'.")
            return

    stage_idx = manifest.get("current_stage_index", 0)
    if stage_idx >= len(stages):
        manifest["status"] = "READY_FOR_SIGN_OFF"
        save_manifest(project_id, manifest)
        print("\n" + "=" * 80)
        print(f" 🏁 WORKFLOW SELESAI: SELURUH TAHAPAN TELAH TUNTAS ({len(stages)}/{len(stages)})")
        print("=" * 80)
        print(f" Proyek : {project_id}")
        print(f" Status : 🏁 READY FOR USER SIGN-OFF (Menunggu UAT Pengguna)")
        print("--------------------------------------------------------------------------------")
        print(" Perhatian untuk Agen Pekerja:")
        print(" 🛑 TUGAS TIM SELESAI. Agen pekerja DILARANG menjalankan perintah 'complete'.")
        print(" Sesi agen di worker pane sekarang IDLE dan menunggu instruksi baru.")
        print("--------------------------------------------------------------------------------")
        print(" Petunjuk untuk Pengguna di Control Room:")
        print(" Silakan lakukan User Acceptance Testing (UAT) terhadap hasil pekerjaan tim.")
        print(" Jika sudah sesuai, setujui dan arsipkan proyek via Control Room:")
        print(f" 👉 team-orch complete {project_id}")
        print("=" * 80 + "\n")
        return

    stage = stages[stage_idx]
    role = stage.get("role", "coder")
    gate = stage.get("gate", {})

    # 1. Check User Approval Gate
    if gate.get("type") == "user_approval" and not manifest.get("gate_status", {}).get("user_approved", False):
        print(f"\n================================================================================")
        print(f" 🛑 GATEKEEPER ALERT: Menunggu Persetujuan Pengguna (User Approval Gate)!")
        print(f"================================================================================")
        print(f" Proyek : {project_id}")
        print(f" Tahap  : {stage.get('name')} (Role: {role.upper()})")
        print(f" Berkas : {p_dir}/01-requirements.md")
        print(f"--------------------------------------------------------------------------------")
        print(f" Harap tinjau dokumen kebutuhan, lalu jalankan perintah persetujuan:")
        print(f" 👉 team-orch approve {project_id}")
        print(f"--------------------------------------------------------------------------------")
        print(f" 💡 TIPS SLASH COMMAND ANTIGRAVITY (UAT & REVIEW):")
        print(f"    - Review Kode   : Gunakan /diff (tekan 'c' untuk inline comment pada diff)")
        print(f"    - Tanya Samping : Gunakan /btw <tanya> atau herdr-orch btw <pane> \"<tanya>\"")
        print(f"    - Simpan Pola   : Gunakan /learn jika ingin menyimpan koreksi/pola permanen")
        print(f"================================================================================")
        return

    # 2. Check Hard Artifact Gate: Verify all required input artifacts exist on disk before starting
    required_inputs = stage.get("input_artifacts", [])
    missing_inputs = []
    for art in required_inputs:
        art_path = p_dir / art
        if not art_path.exists():
            missing_inputs.append(art)

    if missing_inputs:
        print(f"\n================================================================================")
        print(f" 🛑 ARTIFACT GATE: Berkas masukan (input artifacts) belum tersedia!")
        print(f"================================================================================")
        print(f" Proyek : {project_id}")
        print(f" Tahap  : {stage.get('name')} (Tahap {stage_idx + 1}/{len(stages)}, Role: {role.upper()})")
        print(f" Direktori Proyek : {p_dir}")
        print(f" Berkas masukan yang belum ditemukan:")
        for m in missing_inputs:
            print(f"   - ❌ {m}")
        print(f"--------------------------------------------------------------------------------")
        print(f" Tahap ini dikunci secara ketat sampai tahap sebelumnya menghasilkan artefak di atas.")
        print(f" Pencegahan halusinasi: Alur SDLC tidak dapat melompati tahapan tanpa artefak valid.")
        print(f"================================================================================")
        return

    # 3. Check Current Stage State (Output Artifacts Barrier)
    stage_id = stage.get("id")
    current_status = manifest.setdefault("stage_status", {}).get(stage_id)
    output_artifacts = stage.get("output_artifacts", [])

    if current_status == "DISPATCHED" and not getattr(args, "force", False) and not getattr(args, "dry_run", False):
        missing_outputs = []
        for out_art in output_artifacts:
            out_path = p_dir / out_art
            if not out_path.exists():
                t_dir = manifest.get("target_dir")
                if t_dir and (WORKSPACE_ROOT / t_dir / out_art).exists():
                    continue
                missing_outputs.append(out_art)

        # Extra verification for development stage: verify code and non-template review-log
        if stage_id == "development":
            t_dir = manifest.get("target_dir")
            has_code = False
            if t_dir:
                t_path = WORKSPACE_ROOT / t_dir
                if t_path.exists() and any(p for p in t_path.rglob("*.*") if p.is_file() and p.name != ".gitkeep"):
                    has_code = True
            rev_file = p_dir / "review-log.md"
            rev_ready = False
            if rev_file.exists():
                r_txt = rev_file.read_text(encoding="utf-8")
                if ("TASK-" in r_txt.upper() or "IMPLEMENTASI" in r_txt.upper() or "REVIEW REQUEST" in r_txt.upper()) and "MENUNGGU CODER" not in r_txt.upper():
                    rev_ready = True
            if not has_code:
                missing_outputs.append(f"source code files in '{t_dir or 'target_dir'}'")
            if not rev_ready and "review-log.md" not in missing_outputs:
                missing_outputs.append("review-log.md (filled with implementation & review request)")

        if missing_outputs:
            assigned_pane = manifest.get("assigned_panes", {}).get(role, "unknown")
            print(f"\n================================================================================")
            print(f" ⏳ TAHAP SEDANG BERJALAN: '{stage.get('name')}' ({role.upper()})")
            print(f"================================================================================")
            print(f" Proyek : {project_id}")
            print(f" Status : Worker di pane '{assigned_pane}' sedang mengeksekusi sub-task.")
            print(f" Berkas luaran yang sedang ditunggu di {p_dir}:")
            for m in missing_outputs:
                print(f"   - ⏳ {m}")
            print(f"--------------------------------------------------------------------------------")
            print(f" Silakan pantau perkembangan kerja agen di pane '{assigned_pane}'.")
            print(f" Gunakan opsi --force jika ingin mengirim ulang sinyal pemicu ke worker pane.")
            print(f"================================================================================")
            return
        else:
            # Output artifacts are ready! Mark completed and advance to next stage!
            manifest["stage_status"][stage_id] = "COMPLETED"
            stage_idx += 1
            manifest["current_stage_index"] = stage_idx
            if stage_idx >= len(stages):
                manifest["status"] = "READY_FOR_SIGN_OFF"
                save_manifest(project_id, manifest)
                append_audit_log(
                    project_id=project_id,
                    role="system",
                    event="ALL_STAGES_COMPLETED",
                    desc=f"Seluruh {len(stages)} tahapan teknis workflow telah selesai. Status beralih ke READY_FOR_SIGN_OFF.",
                    status="PASS",
                    security="ALL OUTPUT ARTIFACTS VERIFIED",
                    next_step=f"Menunggu verifikasi UAT & sign-off Pengguna di Control Room via: team-orch complete {project_id}"
                )
                record_bus_event(
                    project_id=project_id,
                    from_role="system",
                    to_role="control_room",
                    event_type="GATE_APPROVAL_NEEDED",
                    payload={"project_id": project_id, "gate": "user_sign_off", "status": "READY_FOR_SIGN_OFF"}
                )
                print("\n" + "=" * 80)
                print(f" 🏁 WORKFLOW SELESAI: SELURUH TAHAPAN TELAH TUNTAS ({len(stages)}/{len(stages)})")
                print("=" * 80)
                print(f" Proyek : {project_id}")
                print(f" Status : 🏁 READY FOR USER SIGN-OFF (Menunggu UAT Pengguna)")
                print("--------------------------------------------------------------------------------")
                print(" Perhatian untuk Agen Pekerja:")
                print(" 🛑 TUGAS TIM SELESAI. Agen pekerja DILARANG menjalankan perintah 'complete'.")
                print(" Sesi agen di worker pane sekarang IDLE dan menunggu instruksi baru.")
                print("--------------------------------------------------------------------------------")
                print(" Petunjuk untuk Pengguna di Control Room:")
                print(" Silakan lakukan User Acceptance Testing (UAT) terhadap hasil pekerjaan tim.")
                print(" Jika sudah sesuai, setujui dan arsipkan proyek via Control Room:")
                print(f" 👉 team-orch complete {project_id}")
                print("=" * 80 + "\n")
                return
            stage = stages[stage_idx]
            role = stage.get("role", "coder")
            gate = stage.get("gate", {})
            stage_id = stage.get("id")

            # Check gate for new stage
            if gate.get("type") == "user_approval" and not manifest.get("gate_status", {}).get("user_approved", False):
                print(f"\n================================================================================")
                print(f" 🛑 GATEKEEPER ALERT: Menunggu Persetujuan Pengguna (User Approval Gate)!")
                print(f"================================================================================")
                print(f" Proyek : {project_id}")
                print(f" Tahap  : {stage.get('name')} (Role: {role.upper()})")
                print(f" Berkas : {p_dir}/01-requirements.md")
                print(f"--------------------------------------------------------------------------------")
                print(f" Harap tinjau dokumen kebutuhan, lalu jalankan perintah persetujuan:")
                print(f" 👉 team-orch approve {project_id}")
                print(f"================================================================================")
                save_manifest(project_id, manifest)
                return

    # Determine Model & Worker Pane
    r_data = get_role_data(role)
    model = ROLE_MODELS.get(role.lower(), "gemini-3.8-flash-high")
    if r_data.get("model_tier") == "high":
