def resolve_cmd(cmd_name: str) -> Optional[str]:
    local_bin = WORKSPACE_ROOT / "cmd" / cmd_name
    if local_bin.is_file() and os.access(local_bin, os.X_OK):
        return str(local_bin)
    found = shutil.which(cmd_name)
    if found:
        return found
    return None

