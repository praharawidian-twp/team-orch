def _sanitize_domain_id(domain_id: str) -> str:
    return re.sub(r"[^a-zA-Z0-9_-]", "-", str(domain_id).strip()).lower()

def find_domain_dir(domain_id: Optional[str]) -> Optional[Path]:
    if not domain_id or str(domain_id).strip().lower() in ("", BASE_DOMAIN_ID, "none"):
        return None
    clean_id = _sanitize_domain_id(domain_id)
    local_cand = LOCAL_DOMAINS_DIR / clean_id
    if local_cand.is_dir() and (local_cand / "domain.yaml").is_file():
        return local_cand
    global_cand = GLOBAL_DOMAINS_DIR / clean_id
    if global_cand.is_dir() and (global_cand / "domain.yaml").is_file():
        return global_cand
    return None

def list_all_domains() -> List[Dict[str, Any]]:
    found: Dict[str, Dict[str, Any]] = {}
    for scope, root_dir in [("global", GLOBAL_DOMAINS_DIR), ("local", LOCAL_DOMAINS_DIR)]:
        if not root_dir.exists():
            continue
        for entry in sorted(root_dir.iterdir()):
            if not entry.is_dir() or entry.name.startswith("."):
                continue
            manifest_path = entry / "domain.yaml"
            if not manifest_path.is_file():
                continue
            data = load_yaml(manifest_path) or {}
            d_id = _sanitize_domain_id(data.get("domain_id") or entry.name)
            existing_scope = found[d_id]["scope"] if d_id in found else None
            merged_scope = "local+global" if (existing_scope and existing_scope != scope) else scope
            found[d_id] = {
                "domain_id": d_id,
                "name": data.get("name", d_id),
                "description": data.get("description", ""),
                "version": data.get("version", "1.0.0"),
                "organization": (data.get("organization") or {}).get("name", "-"),
                "path": str(entry),
                "scope": merged_scope,
                "manifest": data,
            }
    return [found[k] for k in sorted(found.keys())]

def get_active_domain_id() -> str:
    env_dom = os.environ.get("TEAM_ORCH_DOMAIN", "").strip()
    if env_dom:
        norm = env_dom.lower()
        return BASE_DOMAIN_ID if norm in ("none", BASE_DOMAIN_ID) else _sanitize_domain_id(norm)
    if GLOBAL_ACTIVE_DOMAIN_FILE.is_file():
        data = load_yaml(GLOBAL_ACTIVE_DOMAIN_FILE) or {}
        d_id = str(data.get("active_domain", BASE_DOMAIN_ID)).strip().lower()
        if d_id in ("", "none", BASE_DOMAIN_ID):
            return BASE_DOMAIN_ID
        return _sanitize_domain_id(d_id)
    return BASE_DOMAIN_ID

def set_active_domain_id(domain_id: str):
    clean_id = BASE_DOMAIN_ID if str(domain_id).strip().lower() in ("", "none", BASE_DOMAIN_ID) else _sanitize_domain_id(domain_id)
    GLOBAL_TEAM_DIR.mkdir(parents=True, exist_ok=True)
    payload = {
        "active_domain": clean_id,
        "updated_at": datetime.now().isoformat(),
        "workspace_hint": str(WORKSPACE_ROOT),
    }
    safe_atomic_write(GLOBAL_ACTIVE_DOMAIN_FILE, dump_yaml(payload) + "\n")

def load_domain_manifest(domain_id: Optional[str]) -> Optional[Dict[str, Any]]:
    d_dir = find_domain_dir(domain_id)
    if not d_dir:
        return None
    data = load_yaml(d_dir / "domain.yaml") or {}
    data["_domain_dir"] = str(d_dir)
    data["_domain_id"] = _sanitize_domain_id(data.get("domain_id") or d_dir.name)
    return data

def resolve_project_domain(manifest: Dict[str, Any], explicit_domain: Optional[str] = None) -> Tuple[str, Optional[Dict[str, Any]], Optional[str]]:
    """
    Resolve effective domain for a project with strict anti-bleed guardrails.
    Returns: (effective_domain_id, domain_manifest_or_none, mismatch_error_msg_or_none)
    """
    active_id = _sanitize_domain_id(explicit_domain) if explicit_domain else get_active_domain_id()
    if active_id in ("", "none"):
        active_id = BASE_DOMAIN_ID

    pinned_raw = manifest.get("domain_id")
    pinned_id = _sanitize_domain_id(pinned_raw) if pinned_raw else None

    if pinned_id and pinned_id != active_id and not explicit_domain:
        proj_id = manifest.get("project_id", "<project_id>")
        msg = (
            f"🛑 [DOMAIN CONTEXT MISMATCH GUARD]: Proyek '{proj_id}' terikat pada domain '{pinned_id}', "
            f"tetapi domain aktif saat ini adalah '{active_id}'.\n"
            f"   Untuk mencegah pencampuran konteks antar-domain & halusinasi agen, eksekusi ditahan.\n"
            f"   Pilih salah satu tindakan eksplisit:\n"
            f"   1. Pindah domain aktif ke proyek ini : team-orch domain use {pinned_id}\n"
            f"   2. Ubah ikatan domain proyek ini     : team-orch domain bind {proj_id} {active_id}"
        )
        return pinned_id, load_domain_manifest(pinned_id), msg

    eff_id = pinned_id or active_id
    if eff_id == BASE_DOMAIN_ID:
        return BASE_DOMAIN_ID, None, None

    d_manifest = load_domain_manifest(eff_id)
    if not d_manifest:
        msg = (
            f"🛑 [DOMAIN PACK MISSING]: Domain '{eff_id}' tidak ditemukan di:\n"
            f"   - {LOCAL_DOMAINS_DIR / eff_id}\n"
            f"   - {GLOBAL_DOMAINS_DIR / eff_id}\n"
            f"   Jalankan 'team-orch domain list' untuk memeriksa domain tersedia atau 'team-orch domain use base'."
        )
        return eff_id, None, msg
    return eff_id, d_manifest, None

def validate_domain_pack(domain_id: str) -> Tuple[bool, List[str], List[str]]:
    errors: List[str] = []
    warnings: List[str] = []
    d_dir = find_domain_dir(domain_id)
    if not d_dir:
        return False, [f"Domain '{domain_id}' tidak ditemukan di local maupun global store."], []

    manifest = load_yaml(d_dir / "domain.yaml")
    if not isinstance(manifest, dict) or not manifest.get("domain_id"):
        errors.append("domain.yaml tidak valid atau tidak memiliki field 'domain_id'.")
        return False, errors, warnings

    bp_rel = manifest.get("boilerplates_file")
    if bp_rel and not (d_dir / bp_rel).is_file():
        warnings.append(f"boilerplates_file '{bp_rel}' belum tersedia di {d_dir}.")

    tmpls = manifest.get("templates") or {}
    if isinstance(tmpls, dict):
        for t_key in ("qad_docx", "qa_report_md"):
            t_val = tmpls.get(t_key)
            if t_val and not (d_dir / t_val).is_file():
                warnings.append(f"Template '{t_key}' ({t_val}) tidak ditemukan di {d_dir}.")

    # Check knowledge registry and ID collisions with Base Domain
    base_reg_file = get_knowledge_dir() / "registry.yaml"
    base_ids = set()
    if base_reg_file.is_file():
        b_data = load_yaml(base_reg_file) or {}
        base_ids = {str(x.get("id")) for x in b_data.get("knowledge_catalog", []) if x.get("id")}

    k_rel = manifest.get("knowledge_dir", "knowledge")
    k_dir = d_dir / k_rel
    reg_file = k_dir / "registry.yaml"
    if reg_file.is_file():
        d_reg = load_yaml(reg_file) or {}
        for item in d_reg.get("knowledge_catalog", []):
            tid = str(item.get("id", ""))
            if tid in base_ids:
                warnings.append(f"Konflik ID topik '{tid}' dengan Base Knowledge (Base akan diprioritaskan).")
            t_file = item.get("file")
            if t_file and not (k_dir / t_file).is_file():
                errors.append(f"Topik knowledge '{tid}' merujuk berkas yang hilang: {k_dir / t_file}")
    else:
        warnings.append(f"Knowledge registry belum ada di {reg_file}.")

    return (len(errors) == 0), errors, warnings

def format_domain_context_block(domain_id: str, d_manifest: Optional[Dict[str, Any]]) -> str:
    if domain_id == BASE_DOMAIN_ID or not d_manifest:
        return (
            "\n### [ACTIVE DOMAIN CONTEXT: BASE (Zero Institutional Knowledge)]:\n"
            "- Domain Mode: `base` (Day-1 Employee / Tanpa Data Spesifik Perusahaan)\n"
            "- Aturan Anti-Halusinasi: DILARANG mengarang nama organisasi, URL portal internal, pejabat/PIC, "
            "template berlogo, atau boilerplate khusus. Jika pekerjaan membutuhkan konteks spesifik perusahaan, "
            "tanyakan langsung kepada Pengguna di Control Room atau sarankan `team-orch domain init/use`."
        )

    org = d_manifest.get("organization") or {}
    apps = d_manifest.get("applications") or []
    officials = d_manifest.get("officials") or []
    tmpls = d_manifest.get("templates") or {}
    d_dir = Path(d_manifest.get("_domain_dir", ""))

    lines = [
        f"\n### [ACTIVE DOMAIN CONTEXT: {domain_id.upper()}]:",
        f"- Domain ID: `{domain_id}` ({d_manifest.get('name', domain_id)})",
        f"- Domain Path: `{d_dir}`",
        f"- Organisasi: {org.get('name', '-')} | Divisi: {org.get('division', '-')}",
    ]
    if org.get("brand_color"):
        lines.append(f"- Brand Color Dokumen: `{org.get('brand_color')}`")
    if org.get("confidentiality_notice"):
        lines.append(f"- Disclaimer Resmi: {org.get('confidentiality_notice')}")

    if apps:
        lines.append("- Aplikasi & Domain Internal Resmi:")
        for app in apps:
            if isinstance(app, dict):
                raw_doms = app.get("internal_domains") or []
                if isinstance(raw_doms, str):
                    doms = raw_doms
                else:
                    fmt_doms = []
                    for d_item in raw_doms:
                        if isinstance(d_item, dict):
                            env_k = d_item.get("env")
                            url_v = d_item.get("url") or d_item.get("host") or str(d_item)
                            fmt_doms.append(f"{env_k}: {url_v}" if env_k else str(url_v))
                        else:
                            fmt_doms.append(str(d_item))
                    doms = ", ".join(fmt_doms) or "-"
                lines.append(f"  • `{app.get('id', '-')}`: {app.get('name', '-')} (URLs: {doms})")

    if officials:
        lines.append("- Daftar Pejabat / Approver Resmi:")
        for off in officials:
            if isinstance(off, dict):
                lines.append(f"  • {off.get('role', '-')}: {off.get('name', '-')}")

    if isinstance(tmpls, dict) and any(tmpls.values()):
        lines.append("- Template Dokumen Resmi Domain:")
        for tk in ("qad_docx", "qa_report_md", "external_reference_dir"):
            if tmpls.get(tk):
                lines.append(f"  • {tk}: `{tmpls.get(tk)}`")

    bp_file = d_manifest.get("boilerplates_file")
    if bp_file and (d_dir / bp_file).is_file():
        bp_data = load_yaml(d_dir / bp_file) or {}
        repos = bp_data.get("repositories") or []
        if repos:
            lines.append("- Boilerplate Terdaftar di Domain Ini:")
            for r in repos:
                if isinstance(r, dict):
                    lines.append(f"  • {r.get('name', r.get('id'))}: `{r.get('url', '-')}` ({r.get('type', '-')})")

    lines.append("- Konsistensi Konteks: Gunakan HANYA data domain di atas. DILARANG mencampur konteks dari domain lain.")
    return "\n".join(lines)

def load_knowledge_catalog(domain_id: Optional[str] = None) -> List[Dict[str, Any]]:
    catalog: List[Dict[str, Any]] = []
    seen_ids = set()

    k_dir = get_knowledge_dir()
    reg_file = k_dir / "registry.yaml"
    if not reg_file.exists():
        reg_file = GLOBAL_KNOWLEDGE_DIR / "registry.yaml"
    if reg_file.exists():
        try:
            data = load_yaml(reg_file)
            if isinstance(data, dict):
                for item in data.get("knowledge_catalog", []):
                    if isinstance(item, dict) and item.get("id"):
                        enriched = dict(item)
                        enriched["_source"] = BASE_DOMAIN_ID
                        enriched["_knowledge_dir"] = str(reg_file.parent)
                        catalog.append(enriched)
                        seen_ids.add(str(item["id"]))
        except Exception:
            pass

    eff_domain = domain_id if domain_id is not None else get_active_domain_id()
    if eff_domain and eff_domain != BASE_DOMAIN_ID:
        d_manifest = load_domain_manifest(eff_domain)
        if d_manifest:
            d_dir = Path(d_manifest["_domain_dir"])
            dk_dir = d_dir / d_manifest.get("knowledge_dir", "knowledge")
            d_reg_file = dk_dir / "registry.yaml"
            if d_reg_file.is_file():
                try:
                    d_data = load_yaml(d_reg_file)
                    if isinstance(d_data, dict):
                        for item in d_data.get("knowledge_catalog", []):
                            if isinstance(item, dict) and item.get("id"):
                                tid = str(item["id"])
                                if tid in seen_ids:
                                    continue
                                enriched = dict(item)
                                enriched["_source"] = f"domain:{eff_domain}"
                                enriched["_knowledge_dir"] = str(dk_dir)
                                catalog.append(enriched)
                                seen_ids.add(tid)
                except Exception:
                    pass

    return catalog

def get_accessible_knowledge(role: Optional[str], domain_id: Optional[str] = None) -> List[Dict[str, Any]]:
    catalog = load_knowledge_catalog(domain_id=domain_id)
    if not role:
        return catalog
    role_norm = role.lower().strip()
    accessible = []
    for item in catalog:
        acc = item.get("access", "*")
        if acc == "*" or acc == "all":
            accessible.append(item)
        elif isinstance(acc, list):
            lowers = [str(r).lower().strip() for r in acc]
            if role_norm in lowers or "*" in lowers or "all" in lowers:
                accessible.append(item)
        elif isinstance(acc, str):
            if role_norm == acc.lower().strip() or acc == "*":
                accessible.append(item)
    return accessible

# ------------------------------------------------------------------------------
# 2. Lightweight Pure-Python YAML Parser & Dumper (Zero External Dependencies)
# ------------------------------------------------------------------------------

def parse_yaml_value(val_str: str) -> Any:
    val = val_str.strip()
    if val in ("true", "True"): return True
    if val in ("false", "False"): return False
    if val in ("null", "None", "~", ""): return None
    if val.isdigit(): return int(val)
    if (val.startswith('"') and val.endswith('"')) or (val.startswith("'") and val.endswith("'")):
        return val[1:-1]
    if val.startswith("[") and val.endswith("]"):
        inner = val[1:-1].strip()
        if not inner: return []
        return [parse_yaml_value(x.strip()) for x in inner.split(",") if x.strip()]
    return val

def load_yaml(filepath: Union[str, Path]) -> Any:
    path = Path(filepath)
    if not path.exists():
        return {}
    text = path.read_text(encoding="utf-8")
    lines = text.splitlines()

    def parse_block(line_idx: int, min_indent: int) -> Tuple[Any, int]:
        res: Dict[str, Any] = {}
        is_list: Optional[bool] = None
        list_res: List[Any] = []

        while line_idx < len(lines):
            line = lines[line_idx]
            stripped = line.strip()
            if not stripped or stripped.startswith("#"):
                line_idx += 1
                continue

            indent = len(line) - len(line.lstrip(" "))
            if indent < min_indent:
                break

            if stripped.startswith("- "):
                if is_list is None:
                    is_list = True

                content = stripped[2:].strip()
                if ":" in content and not content.startswith("{"):
                    k, v = content.split(":", 1)
                    k = k.strip()
                    v = v.strip()
                    sub_dict: Dict[str, Any] = {}
                    if v in ("|", ">"):
                        ml_lines = []
                        line_idx += 1
                        while line_idx < len(lines):
                            ml_line = lines[line_idx]
                            ml_strip = ml_line.strip()
                            if not ml_strip:
                                ml_lines.append("")
                                line_idx += 1
                                continue
                            ml_indent = len(ml_line) - len(ml_line.lstrip(" "))
                            if ml_indent <= indent:
                                break
                            ml_lines.append(ml_line[indent + 2:])
                            line_idx += 1
                        sub_dict[k] = "\n".join(ml_lines).strip()
                    elif v == "":
                        sub_res, line_idx = parse_block(line_idx + 1, indent + 2)
                        sub_dict[k] = sub_res
                    else:
                        sub_dict[k] = parse_yaml_value(v)
                        line_idx += 1

                    while line_idx < len(lines):
                        nxt_line = lines[line_idx]
                        nxt_strip = nxt_line.strip()
                        if not nxt_strip or nxt_strip.startswith("#"):
                            line_idx += 1
                            continue
                        nxt_indent = len(nxt_line) - len(nxt_line.lstrip(" "))
                        if nxt_indent <= indent or nxt_strip.startswith("- "):
                            break
                        if ":" in nxt_strip:
                            nk, nv = nxt_strip.split(":", 1)
                            nk = nk.strip()
                            nv = nv.strip()
                            if nv in ("|", ">"):
                                ml_lines = []
                                line_idx += 1
                                while line_idx < len(lines):
                                    ml_line = lines[line_idx]
                                    if not ml_line.strip():
                                        ml_lines.append("")
                                        line_idx += 1
                                        continue
                                    ml_indent = len(ml_line) - len(ml_line.lstrip(" "))
                                    if ml_indent <= nxt_indent:
                                        break
                                    ml_lines.append(ml_line[nxt_indent + 2:])
                                    line_idx += 1
                                sub_dict[nk] = "\n".join(ml_lines).strip()
                            elif nv == "":
                                sub_res, line_idx = parse_block(line_idx + 1, nxt_indent + 2)
                                sub_dict[nk] = sub_res
                            else:
                                sub_dict[nk] = parse_yaml_value(nv)
                                line_idx += 1
                        else:
                            line_idx += 1
                    list_res.append(sub_dict)
                    continue
                else:
                    list_res.append(parse_yaml_value(content))
                    line_idx += 1
                    continue
            else:
                if is_list is True:
                    break
                is_list = False

                if ":" in stripped:
                    k, v = stripped.split(":", 1)
                    k = k.strip()
                    v = v.strip()
                    if v in ("|", ">"):
                        ml_lines = []
                        line_idx += 1
                        while line_idx < len(lines):
                            ml_line = lines[line_idx]
                            if not ml_line.strip():
                                ml_lines.append("")
                                line_idx += 1
                                continue
                            ml_indent = len(ml_line) - len(ml_line.lstrip(" "))
                            if ml_indent <= indent:
                                break
                            ml_lines.append(ml_line[indent + 2:])
                            line_idx += 1
                        res[k] = "\n".join(ml_lines).strip()
                    elif v == "":
                        sub_res, line_idx = parse_block(line_idx + 1, indent + 2)
                        res[k] = sub_res
                    else:
                        res[k] = parse_yaml_value(v)
                        line_idx += 1
                else:
                    line_idx += 1

        return (list_res if is_list else res), line_idx

    result, _ = parse_block(0, 0)
    return result

def dump_yaml(data: Any, indent: int = 0) -> str:
    lines = []
    prefix = "  " * indent
    if isinstance(data, dict):
        for k, v in data.items():
            if isinstance(v, dict):
                lines.append(f"{prefix}{k}:")
                lines.append(dump_yaml(v, indent + 1))
            elif isinstance(v, list):
                if not v:
                    lines.append(f"{prefix}{k}: []")
                else:
                    lines.append(f"{prefix}{k}:")
                    lines.append(dump_yaml(v, indent + 1))
            elif isinstance(v, str):
                if "\n" in v:
                    lines.append(f"{prefix}{k}: |")
                    for sub in v.splitlines():
                        lines.append(f"{prefix}  {sub}")
                else:
                    lines.append(f'{prefix}{k}: "{v}"')
            elif v is None:
                lines.append(f"{prefix}{k}: null")
            elif isinstance(v, bool):
                bv = "true" if v else "false"
                lines.append(f"{prefix}{k}: {bv}")
            else:
                lines.append(f"{prefix}{k}: {v}")
    elif isinstance(data, list):
        for item in data:
            if isinstance(item, dict):
                first = True
                for k, v in item.items():
                    if first:
                        if isinstance(v, (dict, list)):
                            lines.append(f"{prefix}- {k}:")
                            lines.append(dump_yaml(v, indent + 2))
                        elif isinstance(v, str):
                            lines.append(f'{prefix}- {k}: "{v}"')
                        elif v is None:
                            lines.append(f"{prefix}- {k}: null")
                        elif isinstance(v, bool):
                            bv = "true" if v else "false"
                            lines.append(f"{prefix}- {k}: {bv}")
                        else:
                            lines.append(f"{prefix}- {k}: {v}")
                        first = False
                    else:
                        sub_prefix = prefix + "  "
                        if isinstance(v, (dict, list)):
                            lines.append(f"{sub_prefix}{k}:")
                            lines.append(dump_yaml(v, indent + 2))
                        elif isinstance(v, str):
                            lines.append(f'{sub_prefix}{k}: "{v}"')
                        elif v is None:
                            lines.append(f"{sub_prefix}{k}: null")
                        elif isinstance(v, bool):
                            bv = "true" if v else "false"
                            lines.append(f"{sub_prefix}{k}: {bv}")
                        else:
                            lines.append(f"{sub_prefix}{k}: {v}")
            else:
                if isinstance(item, str):
                    lines.append(f'{prefix}- "{item}"')
                else:
                    lines.append(f"{prefix}- {item}")
    return "\n".join(l for l in lines if l is not None)

