        print(f"===================== [STAGE PROMPT END] =====================")
        print(f"==================== [TASK HANDOFF FILE] =====================")
        print(f" Berkas: {handoff_file}")
        print(f" Sinyal Trigger: {trigger_message}")
        print(f"================================================================")
        print(f"[*] [DRY-RUN] Selesai simulasi prompt. Status proyek dan stage index TIDAK diubah (strictly read-only).")
        return

    if in_herdr and herdr_bin:
        print(f"[*] Control Room Auto-Dispatch: Memajukan proyek '{project_id}' ke Tahap {stage_idx + 1}/{len(stages)}...")
        print(f"    Tahap  : {stage.get('name')}")
        print(f"    Peran  : {r_data.get('title', role)} (`{model}`)")
        print(f"    Handoff: {handoff_file}")

        # Query live panes from Herdr fleet
        fleet_info = get_herdr_fleet_info()
        live_panes = {p.get("pane_id") for p in fleet_info.get("panes", [])} if fleet_info else set()

        # Prune dead panes from current project manifest
        current_assigned = manifest.get("assigned_panes", {})
        cleaned_assigned = {r_k: p_v for r_k, p_v in current_assigned.items() if p_v in live_panes}
        manifest["assigned_panes"] = cleaned_assigned

        # Collect busy live panes across all active projects
        busy_panes = {os.environ.get("HERDR_PANE_ID", "w8:p1")}
        for other_p in ACTIVE_TASKS_DIR.iterdir():
            if other_p.is_dir():
                mf = other_p / "project.yaml"
                if mf.exists():
                    m_data = load_yaml(mf)
                    for _, p_val in m_data.get("assigned_panes", {}).items():
                        if p_val and p_val in live_panes:
                            busy_panes.add(p_val)

        # Determine execution mode (silent vs fleet)
        if getattr(args, "mode", None):
            manifest["execution_mode"] = args.mode
        elif getattr(args, "silent", False):
            manifest["execution_mode"] = "silent"
        is_silent = (manifest.get("execution_mode") == "silent")

        pane_id = args.pane

        if is_silent:
            # ------------------------------------------------------------------
            # SILENT MODE: All roles & stages share ONE single worker pane
            # ------------------------------------------------------------------
            # 1. Check if a silent worker pane has already been assigned and is live
            existing_silent = cleaned_assigned.get("silent_worker")
            if not pane_id and existing_silent and existing_silent in live_panes:
                pane_id = existing_silent

            # 2. Check if any previously assigned role pane in this project is live
            if not pane_id:
                for r_assigned, p_assigned in cleaned_assigned.items():
                    if p_assigned and p_assigned in live_panes and p_assigned != os.environ.get("HERDR_PANE_ID", "w8:p1"):
                        pane_id = p_assigned
                        break

            # 3. Check any live sibling worker pane (excluding control room)
            if not pane_id and fleet_info:
                for p_info in fleet_info.get("panes", []):
                    pid = p_info.get("pane_id")
                    if pid and pid in live_panes and pid != os.environ.get("HERDR_PANE_ID", "w8:p1"):
                        if not p_info.get("is_rate_limited") and not p_info.get("is_blocked"):
                            pane_id = pid
                            break

            # 4. If no live worker pane exists, ensure or create just ONE worker pane (without multi-pane splitting)
            if not pane_id:
                try:
                    print(f"[*] [SILENT MODE] Membuka 1 shared worker pane terpadu di Herdr...")
                    out = subprocess.check_output([herdr_bin, "ensure-worker", "--model", model], text=True)
                    m = re.search(r"(w\d+:p\d+)", out)
                    if m:
                        pane_id = m.group(1)
                except Exception as e:
                    print(f"[!] Failed to ensure silent worker pane: {e}")

            if pane_id:
                manifest["assigned_panes"]["silent_worker"] = pane_id
        else:
            # ------------------------------------------------------------------
            # FLEET MODE (Default): 1 Role = 1 Dedicated Pane
            # ------------------------------------------------------------------
            if not pane_id:
                existing_p = cleaned_assigned.get(role)
                if existing_p and existing_p in live_panes:
                    pane_id = existing_p

            # If not assigned to a live pane, pick an available unassigned live worker pane
            if not pane_id and fleet_info:
                for p_info in fleet_info.get("panes", []):
                    pid = p_info.get("pane_id")
                    if pid and pid in live_panes and pid not in busy_panes and not p_info.get("is_rate_limited") and not p_info.get("is_blocked"):
                        pane_id = pid
                        break

            # If still no live worker pane available (e.g. user closed panes), force spawn a fresh dedicated pane
            if not pane_id:
                try:
                    print(f"[*] Worker pane untuk peran '{role}' belum tersedia. Membuka dedicated worker pane baru di Herdr...")
                    out = subprocess.check_output([herdr_bin, "ensure-worker", "--force-new", "--model", model], text=True)
                    m = re.search(r"(w\d+:p\d+)", out)
                    if m:
                        pane_id = m.group(1)
                except Exception as e:
                    print(f"[!] Failed to ensure worker pane: {e}")

        if pane_id:
            if is_silent:
                print(f"[🔕 SILENT MODE] Mengirim sinyal pemicu handoff ke shared worker pane: {pane_id} (Peran: {role})")
            else:
                print(f"[✓] Mengirim sinyal pemicu handoff ke dedicated worker pane: {pane_id}")
            cmd = [herdr_bin, "delegate", pane_id, trigger_message, "--model", model, "--role", role, "--reset-on-role-change", "--allow-self"]
            subprocess.run(cmd)

            # Update manifest
            manifest["assigned_panes"][role] = pane_id
            if is_silent:
                manifest["assigned_panes"]["silent_worker"] = pane_id
            manifest["current_stage_id"] = stage.get("id")
            manifest["status"] = "ACTIVE"
            manifest.setdefault("stage_status", {})[stage.get("id")] = "DISPATCHED"
            # Automatic Circuit Breaker reset on stage advance (Zero Token Guard)
            g = manifest.setdefault("guardrails", {})
            g["circuit_breaker_status"] = "ACTIVE"
            g["current_retries"] = 0
            g["turn_count"] = 0
            g["locked_at"] = None
            g["lock_reason"] = None
            save_manifest(project_id, manifest)

            mode_tag = "SILENT" if is_silent else "FLEET"
            append_audit_log(
                project_id=project_id,
                role="pm",
                event="STAGE_DISPATCHED",
                desc=f"Auto-dispatch tahap {stage_idx + 1} ({stage.get('name')}) [{mode_tag}] ke pane {pane_id} untuk peran {role} via task-handoff.md",
                files=["task-handoff.md"],
                cmd=f"team-orch next {project_id}{' --silent' if is_silent else ''}",
                next_step=f"Worker {role} di pane {pane_id} membaca task-handoff.md dan mengeksekusi sub-task"
            )
            print(f"\n[✓] Sukses! Sinyal pemicu berhasil dikirim ke worker pane {pane_id}.")
            print(f"    Berkas Handoff : {handoff_file}")
            print(f"    Pantau status real-time di Control Room via: team-orch status {project_id}")
            return

    # Non-herdr fallback
    print(f"[*] Task handoff telah dibuat untuk peran '{role}' ({model}): {handoff_file}")
    print(f"==================== [STAGE PROMPT START] ====================")
    print(full_prompt)
    print(f"===================== [STAGE PROMPT END] =====================")
    manifest["current_stage_id"] = stage.get("id")
    manifest["status"] = "ACTIVE"
    manifest.setdefault("stage_status", {})[stage.get("id")] = "DISPATCHED"
    save_manifest(project_id, manifest)

def cmd_auto(args):
    """
    Autonomous Pipeline Runner (Auto-Pilot):
    Continuously monitors the active stage of project_id.
    When a worker completes their stage and outputs valid artifacts,
    automatically advances to the next stage without requiring manual intervention.
    Stops when reaching READY_FOR_SIGN_OFF or when blocked by a gate requiring human input.
    """
    project_id = args.project_id
    p_dir = get_project_dir(project_id)
    if not p_dir.exists():
        print(f"[!] Active project '{project_id}' not found.")
        return

    poll_interval = getattr(args, "interval", 5) or 5
    max_timeout = getattr(args, "timeout", 1800) or 1800
    start_time = time.time()

    print("\n" + "=" * 80)
    print(f" 🚀 AUTO-PILOT PIPELINE RUNNER: PROYEK '{project_id.upper()}'")
    print("=" * 80)
    print(f" Status : Pengawasan & Transisi Otonom Penuh Aktif")
    print(f" Polling: setiap {poll_interval} detik | Timeout: {max_timeout} detik")
    print(f" Kontrol: Tekan Ctrl+C untuk kembali ke kendali manual di Control Room.")
    print("=" * 80 + "\n")

    while time.time() - start_time < max_timeout:
        manifest = get_or_create_manifest(project_id)
        status = manifest.get("status", "ACTIVE")
        if status in ("READY_FOR_SIGN_OFF", "COMPLETED"):
            print(f"\n[✓] Auto-Pilot Selesai: Proyek '{project_id}' telah berada di status {status}!")
            return

        cb_status = manifest.get("guardrails", {}).get("circuit_breaker_status", "ACTIVE")
        if cb_status == "LOCKED":
            print(f"\n[!] Circuit breaker LOCKED. Auto-pilot dihentikan. Memerlukan intervensi manusia di Control Room.")
            return

        wf_id = manifest.get("workflow", DEFAULT_WORKFLOW_ID)
        wf = load_workflow(wf_id)
        stages = wf.get("stages", [])
        stage_idx = manifest.get("current_stage_index", 0)

        if stage_idx >= len(stages):
            manifest["status"] = "READY_FOR_SIGN_OFF"
            save_manifest(project_id, manifest)
            print(f"\n[✓] Seluruh {len(stages)} tahapan alur kerja telah tuntas! Status: READY_FOR_SIGN_OFF")
            return

        stage = stages[stage_idx]
        stage_id = stage.get("id")
        role = stage.get("role", "coder")
        gate = stage.get("gate", {})

        # If waiting for user approval gate
        if gate.get("type") == "user_approval" and not manifest.get("gate_status", {}).get("user_approved", False):
            print(f"\n[🛑 GATE ALERT] Tahap '{stage.get('name')}' membutuhkan User Approval Gate.")
            print(f"👉 Silakan tinjau dan setujui via: team-orch approve {project_id}")
            return

        curr_stage_status = manifest.get("stage_status", {}).get(stage_id)

        if curr_stage_status != "DISPATCHED":
            print(f"\n[*] Auto-Pilot: Memajukan dan mendispatch tahap {stage_idx + 1}/{len(stages)}: '{stage.get('name')}' ({role.upper()})...")
            cmd_next(args)
            time.sleep(poll_interval)
            continue

        # Check output artifacts
        output_artifacts = stage.get("output_artifacts", [])
        missing_outputs = []
        for out_art in output_artifacts:
            out_path = p_dir / out_art
            if not out_path.exists():
                t_dir = manifest.get("target_dir")
                if t_dir and (WORKSPACE_ROOT / t_dir / out_art).exists():
                    continue
                missing_outputs.append(out_art)

        if stage_id == "development":
            t_dir = manifest.get("target_dir")
            has_code = False
            if t_dir:
                t_path = WORKSPACE_ROOT / t_dir
                if t_path.exists() and any(p for p in t_path.rglob("*.*") if p.is_file() and p.name != ".gitkeep"):
                    has_code = True
            rev_file = p_dir / "review-log.md"
            rev_ready = False
            if rev_file.exists():
                r_txt = rev_file.read_text(encoding="utf-8")
                if ("TASK-" in r_txt.upper() or "IMPLEMENTASI" in r_txt.upper() or "REVIEW REQUEST" in r_txt.upper()) and "MENUNGGU CODER" not in r_txt.upper():
                    rev_ready = True
            if not has_code:
                missing_outputs.append(f"source code in '{t_dir}'")
            if not rev_ready and "review-log.md" not in missing_outputs:
                missing_outputs.append("review-log.md (filled)")

        if stage_id == "review":
            rev_file = p_dir / "review-log.md"
            if rev_file.exists():
                r_txt = rev_file.read_text(encoding="utf-8")
                if "APPROVED" not in r_txt.upper():
                    missing_outputs.append("review-log.md (APPROVED)")

        if not missing_outputs:
            assigned_pane = manifest.get("assigned_panes", {}).get(role)
            is_busy = False
            if assigned_pane and os.environ.get("HERDR_ENV") == "1":
                try:
                    res = subprocess.run(["herdr", "inspect", assigned_pane], capture_output=True, text=True, timeout=5)
                    if res.returncode == 0:
                        data = json.loads(res.stdout)
                        if data.get("agent_status") == "working":
                            is_busy = True
                except Exception:
                    pass

            if not is_busy:
                print(f"\n[⚡ AUTO-ADVANCE] Artefak tahap '{stage.get('name')}' ({role.upper()}) terverifikasi lengkap & worker IDLE.")
                print(f"👉 Mengalirkan otomatis ke tahap berikutnya...")
                cmd_next(args)
                time.sleep(3)
                continue

        assigned_pane = manifest.get("assigned_panes", {}).get(role, "unknown")
        print(f"⏳ [Auto-Pilot] Menunggu worker {role.upper()} di pane '{assigned_pane}' menyelesaikan tahap {stage_idx + 1}/{len(stages)} ({stage.get('name')})...", end="\r", flush=True)
        time.sleep(poll_interval)

    print(f"\n[!] Waktu batas maksimal ({max_timeout}s) tercapai. Auto-pilot dijeda.")

