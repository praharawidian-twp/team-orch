def cmd_preflight(args):
    """
    Deterministic Fast-Fail Gate:
    Locally validates Python, JS/TS, and JSON syntax in project code
    with ZERO LLM tokens before submitting for human or AI code review.
    """
    project_id = args.project_id
    p_dir = get_project_dir(project_id)
    target_dir = WORKSPACE_ROOT
    if p_dir.exists():
        manifest_path = p_dir / "project.yaml"
        if manifest_path.exists():
            manifest = load_yaml(manifest_path)
            t_rel = manifest.get("target_dir")
            if t_rel:
                target_dir = WORKSPACE_ROOT / t_rel

    print("=" * 80)
    print(f" ⚡ DETERMINISTIC FAST-FAIL GATE (0-TOKEN LOCAL PRE-FLIGHT)")
    print(f"    Project: {project_id} | Target Directory: {target_dir}")
    print("=" * 80)

    errors = []
    checked = 0

    # 1. Python syntax compilation
    import py_compile
    for py_file in target_dir.rglob("*.py"):
        if any(p in py_file.parts for p in [".agents", "node_modules", "__pycache__", ".venv", "venv"]):
            continue
        checked += 1
        try:
            py_compile.compile(str(py_file), doraise=True)
        except py_compile.PyCompileError as e:
            rel = str(py_file.relative_to(WORKSPACE_ROOT)) if py_file.is_relative_to(WORKSPACE_ROOT) else str(py_file)
            errors.append((rel, f"SyntaxError: {getattr(e, 'msg', str(e))}"))

    # 2. JSON validation
    for json_file in target_dir.rglob("*.json"):
        if any(p in json_file.parts for p in [".agents", "node_modules", ".git"]):
            continue
        checked += 1
        try:
            json.loads(json_file.read_text(encoding="utf-8"))
        except Exception as e:
            rel = str(json_file.relative_to(WORKSPACE_ROOT)) if json_file.is_relative_to(WORKSPACE_ROOT) else str(json_file)
            errors.append((rel, f"JSONDecodeError: {e}"))

    # 3. JS syntax check if Node is installed
    node_bin = shutil.which("node")
    if node_bin:
        for js_file in target_dir.rglob("*.js"):
            if any(p in js_file.parts for p in [".agents", "node_modules", ".next", "dist"]):
                continue
            checked += 1
            res = subprocess.run([node_bin, "--check", str(js_file)], capture_output=True, text=True)
            if res.returncode != 0:
                rel = str(js_file.relative_to(WORKSPACE_ROOT)) if js_file.is_relative_to(WORKSPACE_ROOT) else str(js_file)
                errors.append((rel, res.stderr.strip().splitlines()[-1] if res.stderr.strip() else "Syntax error"))

    if errors:
        print(f"\n❌ [PRE-FLIGHT FAILED] Ditemukan {len(errors)} kesalahan sintaks dasar!")
        print("   Review TIDAK BISA diajukan ke Analis (Model Pro) sebelum sintaks diperbaiki:\n")
        for fpath, err in errors:
            print(f"   • {fpath}: {err}")
        print("\n💡 Perbaiki kesalahan sintaks di atas secara lokal terlebih dahulu (0 token LLM terbuang).")
        sys.exit(1)
    else:
        print(f"\n✅ [PRE-FLIGHT PASSED] Berhasil memvalidasi {checked} berkas sumber secara lokal!")
        print("   Semua berkas valid secara struktural dan siap diajukan untuk Code Review.")

def cmd_contract(args):
    """
