    out = [f"# CONTRACT ARTIFACT: {role.upper()} | PROJECT: {project_id}\n"]

    if role in ("coder", "developer"):
        spec = p_dir / "02-technical-spec.md"
        tasks = p_dir / "03-task-list.md"
        if spec.exists():
            out.append("## TARGET ARCHITECTURE & SPEC")
            out.append(spec.read_text(encoding="utf-8"))
        if tasks.exists():
            out.append("\n## TASK CHECKLIST & ACCEPTANCE")
            out.append(tasks.read_text(encoding="utf-8"))
    elif role in ("analyst", "tech-lead", "gatekeeper"):
        req = p_dir / "01-requirements.md"
        spec = p_dir / "02-technical-spec.md"
        if req.exists():
            out.append("## BUSINESS REQUIREMENTS & AC")
            out.append(req.read_text(encoding="utf-8"))
        if spec.exists():
            out.append("\n## PROPOSED ARCHITECTURE")
            out.append(spec.read_text(encoding="utf-8"))
    elif role in ("documenter", "writer"):
        req = p_dir / "01-requirements.md"
        spec = p_dir / "02-technical-spec.md"
        tasks = p_dir / "03-task-list.md"
        for f in (req, spec, tasks):
            if f.exists():
                out.append(f"## {f.stem.upper()}")
                out.append(f.read_text(encoding="utf-8"))
    elif role in ("qa-engineer", "qa", "tester"):
        req = p_dir / "01-requirements.md"
        spec = p_dir / "02-technical-spec.md"
        rev = p_dir / "review-log.md"
        if req.exists():
            out.append("## BUSINESS REQUIREMENTS & AC")
