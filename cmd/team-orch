        print(fpath.read_text(encoding="utf-8"))

    elif action == "draft":
        topic_id = args.topic_id
        clean_id = re.sub(r"[^a-zA-Z0-9_-]", "-", topic_id).lower()
        title = getattr(args, "title", None) or clean_id.replace("-", " ").title()
        draft_file = KNOWLEDGE_DRAFTS_DIR / f"{clean_id}.md"
        template_file = get_templates_dir() / "knowledge-topic-template.md"
        content = ""
        if template_file.exists():
            content = template_file.read_text(encoding="utf-8")
            content = content.replace("[custom-topic-id]", clean_id)
        else:
            content = f"# {title}\n\n## 1. Ringkasan & Aturan\nDraft materi untuk {title}.\n"
        draft_file.write_text(content, encoding="utf-8")
        print("=" * 80)
        print(f" 📝 [DRAFT CREATED] Draf usulan knowledge berhasil disiapkan di:")
        print(f"    {draft_file}")
        print("    Status: STAGING (Belum aktif sampai disetujui Manusia)")
        print(f"\n👉 Untuk mengesahkan draf ini menjadi dokumen aktif, jalankan:")
        print(f"   team-orch knowledge approve {clean_id} --access coder,analyst")
        print("=" * 80)

    elif action == "approve":
        draft_id = args.draft_id
        clean_id = re.sub(r"[^a-zA-Z0-9_-]", "-", draft_id).lower()
        draft_file = KNOWLEDGE_DRAFTS_DIR / f"{clean_id}.md"
        if not draft_file.exists():
            draft_file = KNOWLEDGE_DRAFTS_DIR / draft_id
        if not draft_file.exists():
            print(f"❌ [DRAFT NOT FOUND] Draf '{draft_id}' tidak ditemukan di {KNOWLEDGE_DRAFTS_DIR}")
            sys.exit(1)

        access_val = getattr(args, "access", "*")
        if access_val and "," in access_val:
            access_val = [r.strip().lower() for r in access_val.split(",") if r.strip()]
        elif access_val != "*":
            access_val = [access_val.strip().lower()]

        target_file = KNOWLEDGE_TOPICS_DIR / f"{clean_id}.md"
        target_file.write_text(draft_file.read_text(encoding="utf-8"), encoding="utf-8")
        draft_file.unlink()

        reg_file = KNOWLEDGE_REGISTRY
        catalog_data = {"version": "1.0.0", "knowledge_catalog": catalog}
        existing = False
        for item in catalog_data["knowledge_catalog"]:
            if item.get("id") == clean_id:
                item["access"] = access_val
                item["file"] = f"topics/{clean_id}.md"
                existing = True
                break
        if not existing:
            catalog_data["knowledge_catalog"].append({
                "id": clean_id,
                "title": clean_id.replace("-", " ").title(),
                "file": f"topics/{clean_id}.md",
                "category": getattr(args, "category", "general"),
                "access": access_val,
                "enforcement": "strict",
                "summary": f"Dokumen resmi knowledge untuk {clean_id}"
            })

        reg_file.write_text(dump_yaml(catalog_data), encoding="utf-8")
        print("=" * 80)
        print(f" ✅ [APPROVED & PUBLISHED] Knowledge '{clean_id}' berhasil disahkan!")
        print(f"    Lokasi Dokumen : {target_file}")
        print(f"    Hak Akses      : {access_val}")
        print(f"    Registry       : {reg_file}")
        print("=" * 80)

    elif action in ("reject", "revoke"):
        topic_id = args.topic_id
        clean_id = re.sub(r"[^a-zA-Z0-9_-]", "-", topic_id).lower()
        target_file = KNOWLEDGE_TOPICS_DIR / f"{clean_id}.md"
        draft_file = KNOWLEDGE_DRAFTS_DIR / f"{clean_id}.md"
        if target_file.exists():
            draft_file.write_text(target_file.read_text(encoding="utf-8"), encoding="utf-8")
            target_file.unlink()
        reg_file = KNOWLEDGE_REGISTRY
        catalog_data = {"version": "1.0.0", "knowledge_catalog": [item for item in catalog if item.get("id") != clean_id]}
        reg_file.write_text(dump_yaml(catalog_data), encoding="utf-8")
        print("=" * 80)
        print(f" ↩️ [REVOKED & REVERTED] Knowledge '{clean_id}' berhasil dicabut!")
        print(f"    File ditarik kembali ke draf: {draft_file}")
        print(f"    Status: STAGING DRAFT (Menunggu peninjauan & persetujuan Manusia)")
        print("=" * 80)

def cmd_domain(args):
    action = args.domain_action
    active_id = get_active_domain_id()

    if action == "list":
        domains = list_all_domains()
        print("=" * 80)
        print(" 🧭 MULTI-DOMAIN REGISTRY (Base vs Specific Domain Packs)")
        print("=" * 80)
        base_mark = "👉 [ACTIVE]" if active_id == BASE_DOMAIN_ID else "  "
        print(f" {base_mark} base                 | Day-1 Employee (Zero Institutional Knowledge)")
        for d in domains:
            mark = "👉 [ACTIVE]" if d["domain_id"] == active_id else "  "
            print(f" {mark} {d['domain_id']:<20} | {d['name']} ({d['organization']}) [{d['scope']}]")
            print(f"              Path: {d['path']}")
        print("=" * 80)

    elif action == "current":
        d_manifest = load_domain_manifest(active_id) if active_id != BASE_DOMAIN_ID else None
        if getattr(args, "json", False):
            out = {
                "active_domain": active_id,
                "mode": "base" if active_id == BASE_DOMAIN_ID else "specific",
                "domain_dir": d_manifest.get("_domain_dir") if d_manifest else None,
                "manifest": d_manifest,
            }
            print(json.dumps(out, indent=2, default=str))
            return
        print(f"Active Domain : {active_id}")
        if d_manifest:
            org = d_manifest.get("organization") or {}
            print(f"Name          : {d_manifest.get('name')}")
            print(f"Organization  : {org.get('name', '-')}")
            print(f"Domain Dir    : {d_manifest.get('_domain_dir')}")
        else:
            print("Mode          : Base Domain (Day-1 Employee / Zero Institutional Knowledge)")

    elif action == "show":
        target_id = _sanitize_domain_id(args.domain_id) if getattr(args, "domain_id", None) else active_id
        if target_id == BASE_DOMAIN_ID:
            print("Domain 'base': Day-1 Employee Mode (Zero Institutional Knowledge).")
            return
        d_manifest = load_domain_manifest(target_id)
        if not d_manifest:
            print(f"🛑 Domain '{target_id}' tidak ditemukan.")
            sys.exit(1)
        print("=" * 80)
        print(f" 🧭 DETAIL SPECIFIC DOMAIN PACK: {target_id}")
        print("=" * 80)
        print(format_domain_context_block(target_id, d_manifest).strip())
        print("=" * 80)

    elif action == "use":
        target_id = _sanitize_domain_id(args.domain_id)
        if target_id in ("none", BASE_DOMAIN_ID):
            set_active_domain_id(BASE_DOMAIN_ID)
            print("[✓] Berhasil beralih ke mode 'base' (Day-1 / Zero Institutional Knowledge).")
            return

        ok, errs, warns = validate_domain_pack(target_id)
        if not ok:
            print(f"🛑 Gagal mengaktifkan domain '{target_id}':")
            for e in errs:
                print(f"   - {e}")
            sys.exit(1)
        for w in warns:
            print(f"⚠️  Warning: {w}")

        set_active_domain_id(target_id)
        d_manifest = load_domain_manifest(target_id) or {}
        print(f"[✓] Active Domain sekarang: '{target_id}' ({d_manifest.get('name', target_id)})")
        print(f"    Path: {d_manifest.get('_domain_dir')}")

    elif action == "init":
        raw_id = args.domain_id
        clean_id = _sanitize_domain_id(raw_id)
        if clean_id in ("", BASE_DOMAIN_ID, "none"):
            print("🛑 ID domain tidak valid atau reserved ('base'/'none').")
            sys.exit(1)

        root_dir = GLOBAL_DOMAINS_DIR if getattr(args, "global_scope", False) else LOCAL_DOMAINS_DIR
        target_dir = root_dir / clean_id
        if target_dir.exists():
            print(f"[!] Domain '{clean_id}' sudah ada di: {target_dir}")
            sys.exit(1)

        (target_dir / "templates").mkdir(parents=True, exist_ok=True)
        (target_dir / "knowledge" / "topics").mkdir(parents=True, exist_ok=True)
        (target_dir / "docs").mkdir(parents=True, exist_ok=True)

        tmpl_dir = get_templates_dir()
        manifest_tmpl = tmpl_dir / "domain-manifest-template.yaml"
        org_name = getattr(args, "org", None) or clean_id.replace("-", " ").title()
        disp_name = getattr(args, "name", None) or f"{org_name} Domain Pack"

        if manifest_tmpl.is_file():
            m_txt = manifest_tmpl.read_text(encoding="utf-8")
            m_txt = m_txt.replace("[domain-id]", clean_id)
            m_txt = m_txt.replace("[Nama Organisasi atau Domain Kerja]", disp_name)
            m_txt = m_txt.replace("[Nama Perusahaan / Organisasi]", org_name)
            (target_dir / "domain.yaml").write_text(m_txt, encoding="utf-8")
        else:
            (target_dir / "domain.yaml").write_text(dump_yaml({
                "schema_version": "1.0.0",
                "domain_id": clean_id,
                "name": disp_name,
                "organization": {"name": org_name, "brand_color": "#1B4D3E"},
                "boilerplates_file": "boilerplates.yaml",
                "knowledge_dir": "knowledge",
            }) + "\n", encoding="utf-8")

        bp_tmpl = tmpl_dir / "domain-boilerplates-template.yaml"
        if bp_tmpl.is_file():
            b_txt = bp_tmpl.read_text(encoding="utf-8").replace("[domain-id]", clean_id)
            (target_dir / "boilerplates.yaml").write_text(b_txt, encoding="utf-8")

        (target_dir / "knowledge" / "registry.yaml").write_text(
            dump_yaml({"version": "1.0.0", "knowledge_catalog": []}) + "\n",
            encoding="utf-8"
        )
        print(f"[✓] Specific Domain Pack '{clean_id}' berhasil dibuat di: {target_dir}")
        print(f"    1. Lengkapi metadata, aplikasi, pejabat & template di: {target_dir}/domain.yaml")
        print(f"    2. Aktifkan dengan: team-orch domain use {clean_id}")

    elif action == "bind":
        project_id = args.project_id
        target_id = _sanitize_domain_id(args.domain_id)
        if target_id in ("none", BASE_DOMAIN_ID):
            target_id = BASE_DOMAIN_ID
        elif not find_domain_dir(target_id):
            print(f"🛑 Domain '{target_id}' tidak ditemukan.")
            sys.exit(1)

        p_dir = get_project_dir(project_id)
        if not p_dir.exists():
            print(f"🛑 Proyek '{project_id}' tidak ditemukan.")
            sys.exit(1)
        manifest = get_or_create_manifest(project_id)
        old_dom = manifest.get("domain_id") or BASE_DOMAIN_ID
        manifest["domain_id"] = target_id
        save_manifest(project_id, manifest)
        append_audit_log(
            project_id=project_id,
            role="control_room",
            event="DOMAIN_BOUND",
            desc=f"Mengubah ikatan domain proyek dari '{old_dom}' menjadi '{target_id}'",
            files=["project.yaml"],
        )
        print(f"[✓] Proyek '{project_id}' sekarang terikat ke domain: '{target_id}' (sebelumnya: '{old_dom}')")

    elif action == "validate":
        target_id = _sanitize_domain_id(args.domain_id) if getattr(args, "domain_id", None) else active_id
        if target_id == BASE_DOMAIN_ID:
            print("[✓] Mode 'base' selalu valid (Zero Institutional Knowledge).")
            return
        ok, errs, warns = validate_domain_pack(target_id)
        for w in warns:
            print(f"⚠️  Warning: {w}")
        if ok:
            print(f"[✓] Specific Domain Pack '{target_id}' VALID dan siap digunakan.")
        else:
            print(f"🛑 Validasi domain '{target_id}' GAGAL:")
            for e in errs:
                print(f"   - {e}")
            sys.exit(1)

    elif action == "sync":
        if not LOCAL_DOMAINS_DIR.exists():
            print("[-] Tidak ada folder .agents/domains/ lokal untuk disinkronkan.")
            return
        GLOBAL_DOMAINS_DIR.mkdir(parents=True, exist_ok=True)
        count = 0
        for entry in sorted(LOCAL_DOMAINS_DIR.iterdir()):
            if entry.is_dir() and (entry / "domain.yaml").is_file():
                dest = GLOBAL_DOMAINS_DIR / entry.name
                shutil.copytree(entry, dest, dirs_exist_ok=True)
                print(f"[✓] Disinkronkan ke global store: {entry.name} -> {dest}")
                count += 1
        print(f"[✓] Total {count} Specific Domain Pack berhasil disinkronkan ke {GLOBAL_DOMAINS_DIR}")

